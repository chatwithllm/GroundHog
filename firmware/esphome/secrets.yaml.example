# Copy this file to `secrets.yaml` and fill in real values. secrets.yaml is gitignored.
# 2.4GHz Wi-Fi only (ESP32-C3/C6 are 2.4GHz).
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
# ESPHome native-API encryption key for Home Assistant.
# Generate one at https://esphome.io/components/api.html (base64, 32 bytes).
api_encryption_key: "GENERATE_A_NEW_BASE64_KEY"
